<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="/output.css" rel="stylesheet">
  <title>List your home | HomeSpace</title>
</head>
<body class="min-h-screen bg-stone-50 text-slate-800 antialiased">
  <main class="relative isolate min-h-screen overflow-hidden">
    <div class="absolute inset-x-0 top-0 -z-10 h-[30rem] bg-gradient-to-br from-amber-100 via-stone-50 to-sky-100"></div>
    <div class="absolute -right-20 top-24 -z-10 h-72 w-72 rounded-full bg-amber-300/30 blur-3xl"></div>
    <div class="absolute -left-24 bottom-0 -z-10 h-72 w-72 rounded-full bg-sky-300/25 blur-3xl"></div>

    <div class="mx-auto max-w-6xl px-6 py-6 sm:px-10 lg:px-12">
      <%- include('../partials/navbar') %>

      <section class="mx-auto grid max-w-5xl items-center gap-10 py-12 lg:grid-cols-[0.8fr_1.2fr] lg:py-20">
        <div class="max-w-sm">
          <p class="mb-5 inline-flex items-center gap-2 rounded-full border border-amber-200 bg-amber-50 px-3 py-1 text-sm font-medium text-amber-800">
            <span class="h-2 w-2 rounded-full bg-amber-500"></span>
            Host with confidence
          </p>
          <h1 class="text-4xl font-bold leading-tight tracking-tight text-slate-950 sm:text-5xl">Share a place worth coming home to.</h1>
          <p class="mt-5 text-base leading-7 text-slate-600">Tell us the essentials and create a beautiful first impression for future guests.</p>

          <div class="mt-8 hidden space-y-4 lg:block">
            <div class="flex gap-3">
              <span class="grid h-7 w-7 shrink-0 place-items-center rounded-full bg-slate-900 text-xs font-bold text-white">1</span>
              <p class="pt-0.5 text-sm text-slate-600"><strong class="text-slate-900">Add the details.</strong> Keep it simple and accurate.</p>
            </div>
            <div class="flex gap-3">
              <span class="grid h-7 w-7 shrink-0 place-items-center rounded-full border border-slate-300 bg-white text-xs font-bold text-slate-700">2</span>
              <p class="pt-0.5 text-sm text-slate-600"><strong class="text-slate-900">Publish your listing.</strong> Let the right people find it.</p>
            </div>
          </div>
        </div>

        <form action="/host/add-home" method="post" class="rounded-2xl border border-white/80 bg-white/85 p-6 shadow-2xl shadow-slate-900/10 backdrop-blur sm:p-8">
          <div class="mb-8 flex items-start justify-between gap-4 border-b border-slate-100 pb-6">
            <div>
              <h2 class="text-xl font-bold tracking-tight text-slate-950">Home details</h2>
              <p class="mt-1 text-sm text-slate-500">All fields help guests understand your space.</p>
            </div>
            <span class="rounded-lg bg-amber-50 px-3 py-1.5 text-xs font-semibold text-amber-800">New listing</span>
          </div>

          <div class="space-y-5">
            <div>
              <label for="name" class="mb-2 block text-sm font-semibold text-slate-700">Home name</label>
              <input type="text" name="name" id="name" placeholder="e.g. The Cedar House" required class="block w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-slate-900 focus:ring-4 focus:ring-slate-200">
            </div>

            <div class="grid gap-5 sm:grid-cols-2">
              <div>
                <label for="rent" class="mb-2 block text-sm font-semibold text-slate-700">Full-day rent</label>
                <div class="relative">
                  <span class="pointer-events-none absolute inset-y-0 left-4 flex items-center text-sm font-medium text-slate-400">₹</span>
                  <input type="number" name="rent" id="rent" placeholder="2,500" min="0" class="block w-full rounded-xl border border-slate-300 bg-white py-3 pl-8 pr-4 text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-slate-900 focus:ring-4 focus:ring-slate-200">
                </div>
              </div>
              <div>
                <label for="rentNight" class="mb-2 block text-sm font-semibold text-slate-700">Nightly rent</label>
                <div class="relative">
                  <span class="pointer-events-none absolute inset-y-0 left-4 flex items-center text-sm font-medium text-slate-400">₹</span>
                  <input type="number" name="rentNight" id="rentNight" placeholder="1,800" min="0" class="block w-full rounded-xl border border-slate-300 bg-white py-3 pl-8 pr-4 text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-slate-900 focus:ring-4 focus:ring-slate-200">
                </div>
              </div>
            </div>

            <div>
              <label for="location" class="mb-2 block text-sm font-semibold text-slate-700">Location</label>
              <input type="text" name="location" id="location" placeholder="City, neighbourhood, or landmark" required class="block w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-slate-900 focus:ring-4 focus:ring-slate-200">
            </div>
          </div>

          <button type="submit" class="mt-8 inline-flex w-full items-center justify-center gap-2 rounded-xl bg-slate-900 px-6 py-3.5 text-sm font-semibold text-white shadow-xl shadow-slate-900/20 transition hover:-translate-y-0.5 hover:bg-slate-800 focus:outline-none focus:ring-4 focus:ring-slate-300">
            Publish home listing
            <span aria-hidden="true">&rarr;</span>
          </button>
          <p class="mt-4 text-center text-xs leading-5 text-slate-500">You can update your listing details at any time.</p>
        </form>
      </section>
    </div>
  </main>
</body>
</html>
