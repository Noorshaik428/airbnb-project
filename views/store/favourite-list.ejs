<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="/output.css" rel="stylesheet">
  <title>Your favourites</title>
</head>
<body class="min-h-screen bg-stone-50 text-slate-800 antialiased">
  <main class="relative isolate min-h-screen overflow-hidden">
    <div class="absolute inset-x-0 top-0 -z-10 h-[26rem] bg-gradient-to-br from-rose-100 via-stone-50 to-amber-100"></div>
    <div class="absolute -right-24 top-10 -z-10 h-72 w-72 rounded-full bg-rose-300/25 blur-3xl"></div>
    <div class="absolute -left-24 bottom-0 -z-10 h-72 w-72 rounded-full bg-amber-300/20 blur-3xl"></div>

    <div class="mx-auto flex min-h-screen max-w-6xl flex-col px-6 py-6 sm:px-10 lg:px-12">
      <%- include('../partials/navbar') %>

      <%
        // The list of favourited homes is passed in as `home`.
        // Normalise it once, under a clear name, so the template logic
        // below never has to guess at variable names or shadow itself.
        const favourites = typeof home !== 'undefined' && Array.isArray(home) ? home : [];
      %>

      <section class="pt-14 pb-6 sm:pt-20">
        <p class="mb-4 inline-flex items-center gap-2 rounded-full border border-rose-200 bg-rose-50 px-3 py-1 text-sm font-medium text-rose-700">
          <span aria-hidden="true">♥</span>
          Saved by you
        </p>
        <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <h1 class="text-4xl font-bold tracking-tight text-slate-950 sm:text-5xl">Your favourites</h1>
            <p class="mt-3 max-w-xl text-slate-600">Every home you've hearted, kept in one place, so the search never has to start over.</p>
          </div>
          <p class="text-sm font-medium text-slate-500">
            <%= favourites.length %> home<%= favourites.length === 1 ? '' : 's' %> saved
          </p>
        </div>
      </section>

      <section class="pb-16 sm:pb-24">
        <% if (favourites.length === 0) { %>
          <div class="rounded-2xl border border-dashed border-rose-200 bg-white/70 px-6 py-16 text-center shadow-sm">
            <div class="mx-auto grid h-12 w-12 place-items-center rounded-xl bg-rose-50 text-xl text-rose-600" aria-hidden="true">♥</div>
            <h3 class="mt-4 text-lg font-bold text-slate-900">No favourites yet</h3>
            <p class="mt-2 text-sm text-slate-500">Tap the heart on any home to save it here for later.</p>
            <a href="/homes" class="mt-6 inline-flex rounded-lg bg-slate-900 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-slate-800">
              Explore homes
            </a>
          </div>
        <% } else { %>
          <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            <% favourites.forEach(fav => { %>
              <li class="group overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-slate-900/10">
                <div class="p-5">
                  <div class="flex items-start justify-between gap-3">
                    <div class="min-w-0">
                      <p class="flex items-center gap-1.5 text-sm font-medium text-slate-500">
                        <span class="text-amber-600" aria-hidden="true">●</span>
                        <span class="truncate"><%= fav.location ?? fav.Location ?? 'Location to be confirmed' %></span>
                      </p>
                      <h3 class="mt-2 truncate text-xl font-bold tracking-tight text-slate-950"><%= fav.houseName ?? 'Unnamed home' %></h3>
                    </div>

                    <form action="/favourites/<%= fav.id %>/remove" method="POST" class="shrink-0">
                      <button
                        type="submit"
                        aria-label="Remove from favourites"
                        title="Remove from favourites"
                        class="grid h-9 w-9 place-items-center rounded-full border border-rose-200 bg-rose-50 text-rose-600 transition hover:bg-rose-100 focus:outline-none focus:ring-4 focus:ring-rose-200"
                      >
                        <span aria-hidden="true">♥</span>
                      </button>
                    </form>
                  </div>

                  <div class="mt-4 flex items-center justify-between rounded-xl border border-emerald-100 bg-emerald-50 px-3 py-2.5">
                    <div class="flex items-center gap-2">
                      <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
                      <span class="text-sm font-semibold text-emerald-800">Available now</span>
                    </div>
                    <span class="text-xs font-medium text-emerald-700">Ready to book</span>
                  </div>

                  <div class="mt-4 grid grid-cols-2 divide-x divide-slate-200 rounded-xl bg-stone-50 px-1 py-3">
                    <div class="px-3">
                      <p class="text-xs font-medium text-slate-500">Full day</p>
                      <p class="mt-1 text-sm font-bold text-slate-900">₹<%= fav.rent ?? fav.rentfullday ?? '—' %></p>
                    </div>
                    <div class="px-3">
                      <p class="text-xs font-medium text-slate-500">Per night</p>
                      <p class="mt-1 text-sm font-bold text-slate-900">₹<%= fav.rentNight ?? fav.rentPernight ?? '—' %></p>
                    </div>
                  </div>

                  <a href="/homes/<%= fav.id %>" class="mt-4 flex items-center justify-center rounded-lg border border-slate-300 bg-white px-5 py-3 text-sm font-semibold text-slate-700 transition hover:border-slate-400 hover:bg-slate-50 focus:outline-none focus:ring-4 focus:ring-slate-200">
                    View details
                  </a>
                  <form action="/favourites/delete/<%= fav.id %>" method="POST">
                    <input type="hidden" name="favid" value="<%= fav.id %>">
                    <button type="submit" class="mt-4 flex items-center justify-center rounded-lg border border-slate-300 bg-red-400 px-5 py-3 text-sm font-semibold text-slate-700 transition hover:border-slate-400 hover:bg-slate-50 focus:outline-none focus:ring-4 focus:ring-slate-200">Delete from Favourites</button>
                  </form>
                </div>
              </li>
            <% }) %>
          </ul>
        <% } %>
      </section>

      <footer class="mt-auto text-center text-sm text-slate-500">A better way to find your place.</footer>
    </div>
  </main>
</body>
</html>
