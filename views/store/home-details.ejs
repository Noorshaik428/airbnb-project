<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="/output.css" rel="stylesheet">
  <title><%= home.houseName %> · Home details</title>
</head>
<body class="min-h-screen bg-stone-50 text-slate-800 antialiased">
  <%- include('../partials/navbar') %>

  <main class="mx-auto max-w-6xl px-6 py-8 sm:px-10 sm:py-12 lg:px-12">

    <a href="/homes" class="inline-flex items-center gap-1.5 text-sm font-medium text-slate-500 transition hover:text-slate-800">
      <span aria-hidden="true">&larr;</span>
      Back to homes
    </a>

    <div class="mt-4 flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <p class="flex items-center gap-1.5 text-sm font-medium text-slate-500">
          <span class="text-amber-600" aria-hidden="true">●</span>
          <%= home.location %>
        </p>
        <h1 class="mt-1 text-3xl font-bold tracking-tight text-slate-950 sm:text-4xl">
          <%= home.houseName %>
        </h1>
      </div>
      <span class="inline-flex w-fit items-center gap-2 rounded-full border border-emerald-100 bg-emerald-50 px-3 py-1.5 text-sm font-semibold text-emerald-800">
        <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
        Available now
      </span>
    </div>

    <div class="mt-8 grid gap-8 lg:grid-cols-[1.35fr_1fr] lg:items-start">

      <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <div class="aspect-[4/3] w-full sm:aspect-[16/10]">
          <img
            src="data:image/jpeg;base64,"
            alt="Photo of <%= home.houseName %>"
            class="h-full w-full object-cover"
          >
        </div>
      </div>

      <aside class="lg:sticky lg:top-6">
        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
          <div class="flex items-baseline justify-between">
            <div>
              <p class="text-3xl font-bold text-slate-950">
                &#8377;<%= home.rentPernight ?? home.rentNight ?? '—' %>
              </p>
              <p class="text-sm text-slate-500">per night</p>
            </div>
            <% if (home.rent ?? home.rentfullday) { %>
              <div class="text-right">
                <p class="text-lg font-semibold text-slate-800">&#8377;<%= home.rent ?? home.rentfullday %></p>
                <p class="text-sm text-slate-500">full day</p>
              </div>
            <% } %>
          </div>

          <a
            href="/homes/<%= home.id %>/book"
            class="mt-6 flex w-full items-center justify-center rounded-lg bg-slate-900 px-5 py-3.5 text-sm font-semibold text-white shadow-lg shadow-slate-900/20 transition hover:-translate-y-0.5 hover:bg-slate-800 focus:outline-none focus:ring-4 focus:ring-slate-300"
          >
            Book this home
          </a>

          <div class="mt-3">
            <%- include('../partials/favourite', { home: home }) %>
          </div>

          <p class="mt-4 text-center text-xs text-slate-400">You won't be charged yet</p>
        </div>

        <div class="mt-4 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
          <h2 class="text-sm font-semibold uppercase tracking-[0.14em] text-slate-500">Location</h2>
          <p class="mt-2 flex items-center gap-1.5 text-slate-800">
            <span class="text-amber-600" aria-hidden="true">●</span>
            <%= home.location %>
          </p>
        </div>
      </aside>
    </div>

    <div class="mt-8 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
      <h2 class="text-xl font-bold tracking-tight text-slate-950">About this home</h2>
      <p class="mt-3 max-w-3xl leading-7 text-slate-600">
        <%= home.description ?? `A comfortable, well-kept place in ${home.location}, ready whenever you're ready to book. Reach out to the host with any questions before your stay.` %>
      </p>
    </div>

  </main>
</body>
</html>
